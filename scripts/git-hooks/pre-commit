#!/bin/sh
# Blocks commits that carry keys or personal files. Install: sh scripts/git-hooks/install.sh
bad=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)(\.env(\..*)?|config(-[a-z]+)?\.json|server\.json|gsc_[a-z]+\.json)$|^state|^logs/|^report-|^traffic-' | grep -v 'config\.example\.json')
if [ -n "$bad" ]; then echo "pre-commit: personal files staged, not committing:"; echo "$bad"; exit 1; fi
if git diff --cached -U0 -- . ':!scripts/git-hooks' | grep -E '^\+' | grep -qE 'sk-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{30,}|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{20,}|ya29\.|"refresh_token" *: *"[^"]+|(API_KEY|_TOKEN|SECRET)[A-Z_]* *= *[A-Za-z0-9_-]{16,}'; then
  echo "pre-commit: something that looks like a key is in the staged changes; not committing."; exit 1
fi
